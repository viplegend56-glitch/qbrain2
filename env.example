# Copy these into your host's environment variables (Railway: Variables tab). Never commit a real .env.
PORT=3000
ADMIN_PASSWORD=change-me-to-something-long
DATA_DIR=/data                 # mount a Railway Volume at /data so config + state survive redeploys
RPC_URL=                        # Helius RPC URL, e.g. https://mainnet.helius-rpc.com/?api-key=XXXX (balances, transfers, swaps)
# Optional: AI-written meetings and thoughts. Without it the box uses its built-in lines.
LLM_API_KEY=                    # Anthropic API key from console.anthropic.com
LLM_MODEL=claude-haiku-5-5      # the cheap model is plenty
# Optional defaults (also editable from /admin once DATA_DIR is persistent)
CA=
X_URL=
# Generated from /admin, pasted here, then redeploy. Keys live ONLY here.
TREASURY_KEY=
CAT_KEYS=
